# Public AviQR API gateway URL reachable from this deployment.
AVIQR_CORE_API=https://api.aviqr.in
# Domain must resolve to the deployment server; Caddy provisions HTTPS.
DOMAIN=book.example.com
# White-label theme for this separate client deployment.
BRAND_NAME=Example Hotel Collection
BRAND_PRIMARY=#1f7257
BRAND_ACCENT=#d5a86b
BRAND_LOGO=https://example.com/logo.svg
BRAND_SUPPORT_EMAIL=reservations@example.com
# Blank means all active AviQR properties. Comma-separated hotel UUIDs scopes a client storefront.
PROPERTY_IDS=
